# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Local runtime/test artifacts (reports in demo/ and release/ remain tracked)
__pycache__/
*.pyc
mssql-monitor/data/
mssql-monitor/logs/
mssql-monitor/reports/
mssql-monitor-go/data/
mssql-monitor-go/logs/
mssql-monitor-go/reports/
.test-local.mod
.test-local.sum

# Host-specific settings and build scratch files do not belong in this repository
.config/
.sudo_as_admin_successful
.venv*/
**/build/
**/dist/
*.spec
**/release/*.zip
